{
    "name": "gaussian-splatting-360-integration-devcontainer",
    "dockerComposeFile": ["docker-compose.yml"],
    "service": "workspace",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/git:1.3.4": { }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": ".venv/bin/python3",
                "python.analysis.typeCheckingMode": "standard"
            }
        }
    },
    "hostRequirements": {
        "gpu": true
    },
    // "runArgs": [
    //     "--shm-size=4gb"
    // ],
    "overrideCommand": true,
    "initializeCommand": "ln -rsf .env .devcontainer/.env",
    // "postCreateCommand": "uv sync --locked"
}